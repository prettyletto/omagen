{
  "schemaVersion": 1,
  "id": "pretty.omagen",
  "name": "Omagen",
  "version": "1.0.0",
  "author": "Prettyletto",
  "license": "MIT",
  "description": "Generate Omarchy themes from images",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Omagen.qml",
    "barWidget": "OmagenBarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omagen",
    "description": "Open the Omagen image theme generator",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
